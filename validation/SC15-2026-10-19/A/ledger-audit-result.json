      "exit_code": 0,
      "stdout": "import unittest,copy\nfrom command_summary import summarize\nclass SummaryTests(unittest.TestCase):\n def test_empty(self):self.assertEqual(summarize([]),dict(passed=0,failed=0,failed_labels=[]))\n def test_mixed(self):\n  rows=[dict(label='build',exit_code=0),dict(label='test',exit_code=2),dict(label='lint',exit_code=-9)]\n  self.assertEqual(summarize(rows),dict(passed=1,failed=2,failed_labels=['test','lint']))\n def test_unicode_and_order(self):\n  self.assertEqual(summarize([dict(label='\u96ea',exit_code=1),dict(label='caf\u00e9',exit_code=1)]),dict(passed=0,failed=2,failed_labels=['\u96ea','caf\u00e9']))\n def test_no_mutation(self):\n  rows=[dict(label='x',exit_code=1)];old=copy.deepcopy(rows);summarize(rows);self.assertEqual(rows,old)\n def test_boolean_code_is_invalid(self):\n  with self.assertRaises(ValueError):summarize([dict(label='x',exit_code=True)])\n def test_invalid_fields(self):\n  for row in [dict(label=3,exit_code=0),dict(label='x',exit_code='0'),dict(label='x'),None]:\n   with self.subTest(row=row),self.assertRaises(ValueError):summarize([row])\n",
