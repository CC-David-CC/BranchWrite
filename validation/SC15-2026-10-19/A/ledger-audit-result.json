        "lines": [
          "from collections.abc import Mapping",
          "",
          "",
          "def summarize(records):",
          "    if records is None or isinstance(records, (str, bytes, bytearray)):",
          "        raise ValueError(\"records must be an iterable of command records\")",
          "    try:",
          "        iterator = iter(records)",
          "    except TypeError as exc:",
          "        raise ValueError(\"records must be an iterable of command records\") from exc",
          "",
          "    passed = 0",
          "    failed = 0",
          "    failed_labels = []",
          "",
          "    for row in iterator:",
          "        if not isinstance(row, Mapping):",
          "            raise ValueError(\"each record must be a mapping\")",
          "        if \"label\" not in row or \"exit_code\" not in row:",
          "            raise ValueError(\"each record must contain label and exit_code\")",
          "",
          "        label = row[\"label\"]",
          "        exit_code = row[\"exit_code\"]",
          "",
          "        if not isinstance(label, str):",
          "            raise ValueError(\"label must be a string\")",
          "        if isinstance(exit_code, bool) or not isinstance(exit_code, int):",
          "            raise ValueError(\"exit_code must be an integer\")",
          "",
          "        if exit_code == 0:",
          "            passed += 1",
          "        else:",
          "            failed += 1",
          "            failed_labels.append(label)",
          "",
          "    return {\"passed\": passed, \"failed\": failed, \"failed_labels\": failed_labels}",
          ""
