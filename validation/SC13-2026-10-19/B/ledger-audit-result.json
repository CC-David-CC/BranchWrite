          "def parse_line(line):",
          "    if not isinstance(line, str):",
          "        raise ValueError(\"line must be a string\")",
          "",
          "    if line.endswith(\"\\r\\n\"):",
          "        body = line[:-2]",
          "    elif line.endswith(\"\\n\"):",
          "        body = line[:-1]",
          "    else:",
          "        body = line",
          "",
          "    if \"\\r\" in body or \"\\n\" in body:",
          "        raise ValueError(\"embedded CR or LF is invalid\")",
          "",
          "    if \"\\t\" not in body:",
          "        raise ValueError(\"missing tab separator\")",
          "",
          "    code, label = body.split(\"\\t\", 1)",
          "    if not label:",
          "        raise ValueError(\"label must be nonempty\")",
          "",
          "    digits = code[1:] if code[:1] in (\"+\", \"-\") else code",
          "    if not digits or any(ch not in \"0123456789\" for ch in digits):",
          "        raise ValueError(\"exit code must be signed ASCII decimal\")",
          "",
          "    return int(code), label",
          ""
