      "disposition": "read",
      "exit_code": 0,
      "stdout": "import unittest,copy\nfrom taskboard.parser import parse_line\nfrom taskboard.report import summarize\nclass ParserTests(unittest.TestCase):\n def test_exit_codes(self):\n  self.assertEqual(parse_line('-9\\tbuild'),(-9,'build'))\n  self.assertEqual(parse_line('+2\\ttest'),(2,'test'))\n def test_preserves_labels(self):\n  self.assertEqual(parse_line('1\\t  caf\u00e9:\u96ea\\t\u03bb  '),(1,'  caf\u00e9:\u96ea\\t\u03bb  '))\n def test_line_endings(self):\n  self.assertEqual(parse_line('0\\tbuild\\r\\n'),(0,'build'))\n  self.assertEqual(parse_line('2\\ttest\\n'),(2,'test'))\n def test_invalid(self):\n  for value in [None,4,'missing','x\\tlabel',' 0\\tlabel','0\\t','0\\tbad\\ninside','0\\tbad\\rinside']:\n   with self.subTest(value=value),self.assertRaises(ValueError):parse_line(value)\nclass ReportTests(unittest.TestCase):\n def test_empty(self):self.assertEqual(summarize([]),dict(passed=0,failed=0,failed_labels=[]))\n def test_mixed(self):\n  self.assertEqual(summarize(['0\\tbuild','2\\ttest','-9\\tlint']),dict(passed=1,failed=2,failed_labels=['test','lint']))\n def test_unicode_order_and_no_mutation(self):\n  rows=['1\\t \u96ea ','0\\tok','2\\tcaf\u00e9'];before=copy.deepcopy(rows)\n  self.assertEqual(summarize(rows),dict(passed=1,failed=2,failed_labels=[' \u96ea ','caf\u00e9']));self.assertEqual(rows,before)\n def test_invalid_propagates(self):\n  with self.assertRaises(ValueError):summarize(['0\\tok','invalid'])\n",
