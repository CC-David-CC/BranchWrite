{"baseline_inventory": "d72c0924e70c76987ed83dc184522531dbe66b8af38500b04c018dbaa919b829", "baseline_reference": "eedc775b731c6ae0c9215624d7f32797a288e89a1abd9d826d90016ccdbca01e:225", "changes": [{"after_bytes": 690, "after_final_newline": true, "after_mode": 436, "after_sha256": "a7f024789ebdf7c622922e1ba7cfb566302144704c7412c4fda3ab3560b21f53", "before_bytes": 85, "before_final_newline": true, "before_mode": 436, "before_sha256": "a7643501c583f9f108df082937aadbb2c6a4a687103663e04bedf5d1d614ed08", "binary": false, "diff": "--- before/taskboard/parser.py\n+++ after/taskboard/parser.py\n@@ -1,3 +1,28 @@\n+import re\n+\n+_CODE_RE = re.compile(r\"\\A[+-]?[0-9]+\\Z\")\n+\n+\n def parse_line(line):\n-    code, label = line.split(\"\\t\")\n-    return 0, label.strip()\n+    if not isinstance(line, str):\n+        raise ValueError(\"line must be a string\")\n+\n+    if line.endswith(\"\\r\\n\"):\n+        body = line[:-2]\n+    elif line.endswith(\"\\n\"):\n+        body = line[:-1]\n+    else:\n+        body = line\n+\n+    if \"\\r\" in body or \"\\n\" in body:\n+        raise ValueError(\"embedded CR or LF\")\n+\n+    code_text, separator, label = body.partition(\"\\t\")\n+    if not separator:\n+        raise ValueError(\"missing tab separator\")\n+    if not label:\n+        raise ValueError(\"empty label\")\n+    if not _CODE_RE.match(code_text):\n+        raise ValueError(\"invalid exit code\")\n+\n+    return int(code_text), label\n", "path": "taskboard/parser.py"}, {"after_bytes": 376, "after_final_newline": true, "after_mode": 436, "after_sha256": "4c4093bf919f0dca4a55c0be7e540ec398caab031a0b11df1f2745d354f04bba", "before_bytes": 169, "before_final_newline": true, "before_mode": 436, "before_sha256": "685b498185c7bedbdab1159570f9cbadbf41b048776e7f8b6dcc72d3f0a528b1", "binary": false, "diff": "--- before/taskboard/report.py\n+++ after/taskboard/report.py\n@@ -1,5 +1,17 @@\n from .parser import parse_line\n \n+\n def summarize(lines):\n-    rows = [parse_line(line) for line in lines]\n-    return {\"passed\": len(rows), \"failed\": 0, \"failed_labels\": []}\n+    passed = 0\n+    failed = 0\n+    failed_labels = []\n+\n+    for line in lines:\n+        code, label = parse_line(line)\n+        if code == 0:\n+            passed += 1\n+        else:\n+            failed += 1\n+            failed_labels.append(label)\n+\n+    return {\"passed\": passed, \"failed\": failed, \"failed_labels\": failed_labels}\n", "path": "taskboard/report.py"}], "complete_project_patch": true, "coverage": "complete-project", "created_directories": [], "current_inventory": "9b205cff7a7d83e38e6e6c2f9d5c2a1df5bf5c9059551fadc75a902529e9ec14", "recorded_verified": true, "schema": 1}
