{"baseline_inventory": "1a96cc86267161a7495c83f5c67002967cc14caaf96370e9e9fcab3889d32ac2", "baseline_reference": "aa11264a17363aea6e7500d57046cbaaa999741b09feeb12ad58417ab07d818c:225", "changes": [{"after_bytes": 965, "after_final_newline": true, "after_mode": 436, "after_sha256": "6d38f9886c0561ad3ec0793d2a4683a8df4cd274038c82c527437775618ed8c2", "before_bytes": 94, "before_final_newline": true, "before_mode": 436, "before_sha256": "b0066008c576c410df2fba793acb7502a06f41e5a7604ded9223d70c765d2178", "binary": false, "diff": "--- before/command_summary.py\n+++ after/command_summary.py\n@@ -1,2 +1,36 @@\n+from collections.abc import Mapping\n+\n+\n def summarize(records):\n-    return {\"passed\": len(records), \"failed\": 0, \"failed_labels\": []}\n+    try:\n+        rows = list(records)\n+    except TypeError as exc:\n+        raise ValueError(\"records must be iterable\") from exc\n+\n+    passed = 0\n+    failed_labels = []\n+\n+    for row in rows:\n+        if not isinstance(row, Mapping):\n+            raise ValueError(\"invalid row\")\n+        if \"label\" not in row or \"exit_code\" not in row:\n+            raise ValueError(\"invalid row\")\n+\n+        label = row[\"label\"]\n+        exit_code = row[\"exit_code\"]\n+\n+        if not isinstance(label, str):\n+            raise ValueError(\"label must be a string\")\n+        if isinstance(exit_code, bool) or not isinstance(exit_code, int):\n+            raise ValueError(\"exit_code must be an integer\")\n+\n+        if exit_code == 0:\n+            passed += 1\n+        else:\n+            failed_labels.append(label)\n+\n+    return {\n+        \"passed\": passed,\n+        \"failed\": len(failed_labels),\n+        \"failed_labels\": failed_labels,\n+    }\n", "path": "command_summary.py"}], "complete_project_patch": true, "coverage": "complete-project", "created_directories": [], "current_inventory": "08dc9fa4e2dc655e4a4a779c01e45ca3ae32960505d6bcd4eac3649f7e9f80cf", "recorded_verified": true, "schema": 1}
